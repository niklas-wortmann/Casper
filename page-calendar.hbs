{{!< default}}

{{#post}}
<main id="site-main" class="site-main outer calendar-page">
    <div class="inner calendar-layout">
        <section class="calendar-intro">
            <p class="calendar-kicker">Speaking and collaboration</p>
            <h1>{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="calendar-description">{{custom_excerpt}}</p>
            {{else}}
                <p class="calendar-description">Pick a time to discuss a talk, podcast appearance, or practical collaboration around AI-assisted development and developer tooling.</p>
            {{/if}}
            <div class="calendar-notes">
                <span>Speaking</span>
                <span>Podcast</span>
                <span>Collaboration</span>
            </div>
        </section>
        <section class="calendar-panel gh-content">
            {{content}}
        </section>
    </div>
</main>
{{/post}}
