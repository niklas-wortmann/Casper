{{!< default}}

{{#post}}
<main id="site-main" class="site-main outer calendar-page">
    <div class="inner calendar-layout">
        <section class="calendar-intro">
            <p class="calendar-kicker">Coffee chat</p>
            <h1>{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="calendar-description">{{custom_excerpt}}</p>
            {{else}}
                <p class="calendar-description">Grab a coffee chat to discuss AI-assisted development, developer tooling, podcasts, talks, or a collaboration idea.</p>
            {{/if}}
            <div class="calendar-notes">
                <span>AI workflows</span>
                <span>Tooling</span>
                <span>Ideas</span>
            </div>
        </section>
        <section class="calendar-panel gh-content">
            {{content}}
        </section>
    </div>
</main>
{{/post}}
