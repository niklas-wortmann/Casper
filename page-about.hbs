{{!< default}}

{{#post}}
<header class="about-profile outer">
    <div class="inner about-profile-inner">
        <img class="about-profile-avatar" src="{{asset "images/wordman-headshot.png"}}" alt="Jan-Niklas Wortmann">
        <div class="about-profile-copy">
            <p class="about-profile-kicker">Host of Dev&apos;s Brew &middot; Solution Architect at Cursor</p>
            <h1>Jan-Niklas Wortmann</h1>
            <p>I test AI coding workflows in real codebases, then explain what held up, what broke, and what a working developer can actually use.</p>
        </div>
    </div>
</header>

<main id="site-main" class="site-main">
    <article class="article about-page {{post_class}}">
        <section class="about-content gh-canvas">
            {{content}}
        </section>

        <section class="about-podcast-cta gh-canvas">
            <h2>Follow Dev&apos;s Brew</h2>
            <div class="about-profile-links about-profile-links--primary">
                <a href="#/portal" data-portal>Get the newsletter</a>
                <a href="https://podcasts.apple.com/us/podcast/the-weekly-devs-brew/id1818009834" target="_blank" rel="noopener">Apple</a>
                <a href="https://open.spotify.com/show/6uG7XUDtY6QqkjG5RmgvPZ" target="_blank" rel="noopener">Spotify</a>
                <a href="https://www.youtube.com/@wordmandotdev" target="_blank" rel="noopener">YouTube</a>
            </div>
            <div class="about-profile-links about-profile-links--secondary">
                <a href="https://x.com/niklas_wortmann" target="_blank" rel="noopener">X</a>
                <a href="https://www.linkedin.com/in/jan-niklas-wortmann/" target="_blank" rel="noopener">LinkedIn</a>
                <a href="https://wordman.dev" target="_blank" rel="noopener">wordman.dev</a>
            </div>
        </section>

        <section class="about-recent-episodes gh-canvas">
            <div class="podcast-listing-header">
                <h2>Recent Episodes</h2>
            </div>
            {{#get "posts" filter="tag:podcast" include="tags,authors" limit="4" as |episodes|}}
                {{#if episodes.length}}
                    <div class="podcast-episode-list">
                        {{#foreach episodes}}
                            <article class="podcast-episode-card">
                                <a class="podcast-episode-link" href="{{url}}">
                                    <div class="podcast-episode-avatar">
                                        {{#if feature_image}}
                                            <img src="{{img_url feature_image size="s"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">
                                        {{else}}
                                            <img src="{{asset "images/wordman-headshot.png"}}" alt="{{title}}" loading="lazy">
                                        {{/if}}
                                    </div>
                                    <div class="podcast-episode-content">
                                        <h3>{{title}}</h3>
                                        {{#if excerpt}}
                                            <p>{{excerpt}}</p>
                                        {{/if}}
                                        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                                    </div>
                                </a>
                            </article>
                        {{/foreach}}
                    </div>
                {{else}}
                    <p>No podcast episodes published yet.</p>
                {{/if}}
            {{/get}}
        </section>

        <section class="about-independence-note gh-canvas">
            <h2>Editorial Independence</h2>
            <p>Dev&apos;s Brew covers all tools honestly. I work at Cursor; that connection is transparent and never dictates the verdict.</p>
        </section>
    </article>
</main>
{{/post}}
