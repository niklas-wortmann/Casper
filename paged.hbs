{{!< default}}

<main id="site-main" class="site-main outer">
<div class="inner posts">
    <section class="collection-hero">
        <h1 class="collection-title">Archive</h1>
        <p class="collection-description">Older posts from wordman.dev.</p>
    </section>

    <div class="post-feed">
        {{#foreach posts}}
            {{> "post-card"}}
        {{/foreach}}
    </div>

    {{pagination}}
</div>
</main>
