{{!< default}}

<main id="site-main" class="site-main outer page-collection page-collection--blog">
<div class="inner posts">
    {{#post}}
        <section class="collection-hero">
            <h1 class="collection-title">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="collection-description">{{custom_excerpt}}</p>
            {{/if}}
            <div class="collection-actions">
                <span class="collection-chip">AI reality checks</span>
                <span class="collection-chip">Practitioner&apos;s edge</span>
                <span class="collection-chip">Industry signal</span>
            </div>
        </section>
    {{/post}}

    {{#get "posts" filter="tag:blog+slug:agent-instructions" include="tags,authors" limit="1" as |posts|}}
        {{#foreach posts}}
            <section class="featured-post">
                <h2 class="featured-post-title">Start here</h2>
                <article class="featured-post-card">
                    <a class="featured-post-image-link{{#unless feature_image}} featured-post-image-link--fallback{{/unless}}" href="{{url}}" aria-label="{{title}}">
                        {{#if feature_image}}
                            <img class="featured-post-image"
                                srcset="{{img_url feature_image size="s"}} 300w,
                                        {{img_url feature_image size="m"}} 600w,
                                        {{img_url feature_image size="l"}} 1000w,
                                        {{img_url feature_image size="xl"}} 2000w"
                                sizes="(max-width: 1200px) 100vw, 1200px"
                                src="{{img_url feature_image size="l"}}"
                                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                                loading="eager"
                            />
                        {{else}}
                            <div class="featured-post-image featured-post-image--fallback"></div>
                        {{/if}}
                    </a>
                    <div class="featured-post-content">
                        <span class="featured-post-kicker">Tested workflow</span>
                        <h2><a href="{{url}}">{{title}}</a></h2>
                        {{#if excerpt}}
                            <p>{{excerpt}}</p>
                        {{/if}}
                        <div class="featured-post-meta">
                            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                            <span>{{reading_time}}</span>
                        </div>
                    </div>
                </article>
            </section>
        {{/foreach}}
    {{/get}}

    {{#get "posts" filter="tag:blog+slug:-agent-instructions" include="tags,authors" limit="6" as |posts|}}
        {{#if posts.length}}
            <section class="collection-post-grid">
                {{#foreach posts}}
                    <article class="collection-post-card">
                        <a class="collection-post-image-link{{#unless feature_image}} collection-post-image-link--fallback{{/unless}}" href="{{url}}" aria-label="{{title}}">
                            {{#if feature_image}}
                                <img class="collection-post-image"
                                    srcset="{{img_url feature_image size="s"}} 300w,
                                            {{img_url feature_image size="m"}} 600w,
                                            {{img_url feature_image size="l"}} 1000w"
                                    sizes="(max-width: 991px) 100vw, 360px"
                                    src="{{img_url feature_image size="m"}}"
                                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                                    loading="lazy"
                                />
                            {{else}}
                                <div class="collection-post-image collection-post-image--fallback"></div>
                            {{/if}}
                        </a>
                        <div class="collection-post-content">
                            {{#primary_tag}}
                                <span class="collection-post-tag">{{name}}</span>
                            {{/primary_tag}}
                            <h3><a href="{{url}}">{{title}}</a></h3>
                            {{#if excerpt}}
                                <p>{{excerpt}}</p>
                            {{/if}}
                            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}} &middot; {{reading_time}}</time>
                        </div>
                    </article>
                {{/foreach}}
            </section>
        {{/if}}
    {{/get}}

    <div class="collection-view-all">
        <a class="hero-button" href="/tag/blog/">Load more</a>
    </div>
</div>
</main>
