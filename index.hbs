{{!< default}}

<header class="site-header">
    <div class="site-header-content outer{{#match @custom.header_style "Left aligned"}} left-aligned{{/match}}{{#unless @custom.show_publication_cover}}{{#match @custom.header_style "Hidden"}} no-content{{/match}}{{/unless}}">
        <div class="site-header-inner inner">
            <section class="brand-hero">
                <h1 class="brand-hero-name"><span class="brand-hero-name-line">Jan-Niklas</span> <span class="brand-hero-name-line">Wortmann</span></h1>
                <div class="brand-hero-avatar">
                    <img src="{{asset "images/wordman-avatar.svg"}}" alt="Jan-Niklas Wortmann">
                </div>
                <p class="brand-hero-description">I test AI coding workflows on real codebases and share what held up, what broke, and why. Host of The Weekly Dev&apos;s Brew. Solution Architect at Cursor.</p>
                <div class="hero-actions">
                    <a class="hero-button" href="{{@site.url}}/blog/">Read the blog</a>
                    <a class="hero-button hero-button--ghost" href="{{@site.url}}/podcast/">Listen to The Weekly Dev&apos;s Brew</a>
                </div>
            </section>
        </div>
    </div>
</header>

<section class="paper-links outer">
    <div class="inner">
        <div class="section-kicker">Start here</div>
        <div class="paper-links-grid">
            <a class="paper-link-card" href="{{@site.url}}/blog/">
                <h2>Blog</h2>
                <p>Tested AI coding workflows and clear verdicts for developers shipping real software.</p>
            </a>
            <a class="paper-link-card" href="{{@site.url}}/talk/">
                <h2>Talks</h2>
                <p>Conference talks on developer tooling, TypeScript, Angular, and Vue, and where AI fits into that work.</p>
            </a>
            <a class="paper-link-card" href="{{@site.url}}/podcast/">
                <h2>Podcast</h2>
                <p>The Weekly Dev&apos;s Brew. Long conversations with engineers and tool builders about what AI actually changes in how they ship code.</p>
            </a>
        </div>
    </div>
</section>

<section class="latest-stack outer">
    <div class="inner">
        <div class="section-kicker">Latest content</div>
        <div class="latest-stack-card">
            {{#get "posts" filter="tag:blog,tag:podcast,tag:talk,tag:talks" include="tags,authors" order="published_at desc" limit="5" as |posts|}}
                {{#if posts.length}}
                    {{#foreach posts}}
                        <article class="latest-stack-item">
                            <a href="{{url}}">
                                <span class="latest-stack-tag">
                                    {{#has tag="podcast"}}Podcast{{else}}{{#has tag="talk,talks"}}Talk{{else}}Blog{{/has}}{{/has}}
                                </span>
                                <h2>{{title}}</h2>
                                <time datetime="{{date published_at format="YYYY-MM-DD"}}">Published {{date published_at format="MMM DD, YYYY"}}</time>
                            </a>
                        </article>
                    {{/foreach}}
                {{else}}
                    <article class="latest-stack-item">
                        <a href="{{@site.url}}/blog/">
                            <span class="latest-stack-tag">Content</span>
                            <h2>Fresh stories are brewing.</h2>
                            <time>Check back soon.</time>
                        </a>
                    </article>
                {{/if}}
            {{/get}}
        </div>
    </div>
</section>
