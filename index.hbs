{{!< default}}

<header class="site-header">
    <div class="site-header-content outer{{#match @custom.header_style "Left aligned"}} left-aligned{{/match}}{{#unless @custom.show_publication_cover}}{{#match @custom.header_style "Hidden"}} no-content{{/match}}{{/unless}}">
        <div class="site-header-inner inner">
            <section class="brand-hero">
                <h1 class="brand-hero-name">JAN-NIKLAS<br>WORTMANN</h1>
                <div class="brand-hero-avatar">
                    <img src="{{asset "images/wordman-avatar.svg"}}" alt="Jan-Niklas Wortmann">
                </div>
                <p class="brand-hero-description">Developer Advocate @ JetBrains. Helping dev teams navigate AI tooling, TypeScript, and modern JavaScript &mdash; without the hype.</p>
                <div class="hero-actions">
                    <a class="hero-button" href="{{@site.url}}/blog/">Read the blog</a>
                    <a class="hero-button hero-button--ghost" href="{{@site.url}}/talk/">View talks</a>
                </div>
            </section>
        </div>
    </div>
</header>

<section class="paper-links outer">
    <div class="inner">
        <div class="section-kicker">Layered paper</div>
        <div class="paper-links-grid">
            <a class="paper-link-card" href="{{@site.url}}/blog/">
                <h2>Blog</h2>
                <p>Deep dives, field notes, and experiments on AI tooling and modern TypeScript workflows.</p>
            </a>
            <a class="paper-link-card" href="{{@site.url}}/talk/">
                <h2>Talks</h2>
                <p>Keynotes, workshops, and live demos for engineering teams and developer organisations.</p>
            </a>
            <a class="paper-link-card" href="{{@site.url}}/newsletter/">
                <h2>Newsletter</h2>
                <p>The Weekly Dev&apos;s Brew: one real AI experiment each week with practical notes from the field.</p>
            </a>
        </div>
    </div>
</section>

<section class="latest-stack outer">
    <div class="inner">
        <div class="section-kicker">Latest posts</div>
        <div class="latest-stack-card">
            {{#get "posts" filter="tag:blog" include="tags,authors" limit="5" as |posts|}}
                {{#if posts.length}}
                    {{#foreach posts}}
                        <article class="latest-stack-item">
                            <a href="{{url}}">
                                <span class="latest-stack-tag">{{#primary_tag}}{{name}}{{else}}Blog{{/primary_tag}}</span>
                                <h2>{{title}}</h2>
                                <time datetime="{{date updated_at format="YYYY-MM-DD"}}">Updated {{date updated_at format="MMM DD, YYYY"}}</time>
                            </a>
                        </article>
                    {{/foreach}}
                {{else}}
                    <article class="latest-stack-item">
                        <a href="{{@site.url}}/blog/">
                            <span class="latest-stack-tag">Blog</span>
                            <h2>Fresh posts are brewing.</h2>
                            <time>Check back soon.</time>
                        </a>
                    </article>
                {{/if}}
            {{/get}}
        </div>
    </div>
</section>
