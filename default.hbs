<!DOCTYPE html>
<html lang="{{@site.locale}}" class="{{#match @custom.color_scheme "Dark"}}dark-mode{{else match @custom.color_scheme "Auto"}}auto-color{{/match}}{{#is "home"}} no-infinite-scroll{{/is}}">
<head>

    {{!-- Basic meta - advanced meta is output with {ghost_head} below --}}
    <title>{{meta_title}}</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    {{!-- Preload scripts --}}
    <link rel="preload" as="style" href="{{asset "built/screen.css"}}" />
    <link rel="preload" as="script" href="{{asset "built/casper.js"}}" />

    {{!-- Theme assets - use the {asset} helper to reference styles & scripts,
    this will take care of caching and cache-busting automatically --}}
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}" />
    <style>
        .weekly-brew-logo {
            display: none;
            height: 40px;
            width: auto;
        }

        .weekly-brew-logo--dark {
            display: inline-block;
        }

        html.dark-mode .weekly-brew-logo--dark {
            display: none;
        }

        html.dark-mode .weekly-brew-logo--light {
            display: inline-block;
        }

        @media (prefers-color-scheme: dark) {
            html.auto-color .weekly-brew-logo--dark {
                display: none;
            }

            html.auto-color .weekly-brew-logo--light {
                display: inline-block;
            }
        }
    </style>

    {{!-- This tag outputs all your advanced SEO meta, structured data, and other important settings,
    it should always be the last tag before the closing head tag --}}
    {{ghost_head}}

</head>
<body class="{{body_class}} is-head-{{#match @custom.navigation_layout "Logo on cover"}}left-logo{{else match @custom.navigation_layout "Logo in the middle"}}middle-logo{{else}}stacked{{/match}}{{#match @custom.title_font "=" "Elegant serif"}} has-serif-title{{/match}}{{#match @custom.body_font "=" "Modern sans-serif"}} has-sans-body{{/match}}{{#if @custom.show_publication_cover}} has-cover{{/if}}">
<div class="viewport">

    <header id="gh-head" class="gh-head outer{{#match @custom.header_style "Hidden"}} is-header-hidden{{/match}}">
        <div class="gh-head-inner inner">
            <div class="gh-head-brand">
                <a class="gh-head-logo gh-head-logo--wordmark" href="{{@site.url}}">
                    {{#match @site.title "=" "wordman.dev"}}Jan-Niklas Wortmann{{else}}{{@site.title}}{{/match}}
                </a>
                <button class="gh-burger" aria-label="Main Menu"></button>
            </div>

            <nav class="gh-head-menu" aria-label="Primary navigation">
                <ul class="nav">
                    <li class="nav-home{{#is "home"}} nav-current{{/is}}"><a href="{{@site.url}}/">Home</a></li>
                    <li class="nav-about{{#is "page"}}{{#post}}{{#match slug "about"}} nav-current{{/match}}{{/post}}{{/is}}"><a href="{{@site.url}}/about/">About</a></li>
                    <li class="nav-calendar"><a href="{{@site.url}}/calendar/">Speaking</a></li>
                    <li class="nav-blog{{#is "page"}}{{#post}}{{#match slug "blog"}} nav-current{{/match}}{{/post}}{{/is}}"><a href="{{@site.url}}/blog/">Blog</a></li>
                    <li class="nav-talks{{#is "page"}}{{#post}}{{#match slug "talk"}} nav-current{{/match}}{{/post}}{{/is}}"><a href="{{@site.url}}/talk/">Talks</a></li>
                    <li class="nav-newsletter{{#is "page"}}{{#post}}{{#match slug "newsletter"}} nav-current{{/match}}{{/post}}{{/is}}"><a href="{{@site.url}}/newsletter/">Newsletter</a></li>
                    <li class="nav-podcast{{#is "page"}}{{#post}}{{#match slug "podcast"}} nav-current{{/match}}{{/post}}{{/is}}"><a href="{{@site.url}}/podcast/">Podcast</a></li>
                </ul>
            </nav>

            <div class="gh-head-actions">
                <div class="gh-head-members">
                {{#if @site.members_enabled}}
                    {{#unless @member}}
                        {{#unless @site.members_invite_only}}
                            <a class="gh-head-button" href="#/portal/signup" data-portal="signup">Get Dev&apos;s Brew</a>
                        {{/unless}}
                    {{else}}
                        <a class="gh-head-button" href="#/portal/account" data-portal="account">Account</a>
                    {{/unless}}
                {{else}}
                    <a class="gh-head-button" href="{{@site.url}}/newsletter/">Get Dev&apos;s Brew</a>
                {{/if}}
                </div>
            </div>
        </div>
    </header>

    <div class="site-content">
        {{!-- All other templates get inserted here, index.hbs, post.hbs, etc --}}
        {{{body}}}
    </div>

    {{!-- The global footer at the very bottom of the screen --}}
    <footer class="site-footer outer">
        <div class="inner site-footer-inner">
            <div class="site-footer-social" aria-label="Social links">
                <a class="gh-social-link" href="https://bsky.app/profile/wordman.dev" target="_blank" rel="noopener" aria-label="Bluesky">{{> "icons/bluesky"}}</a>
                <a class="gh-social-link" href="https://twitter.com/niklas_wortmann" target="_blank" rel="noopener" aria-label="X (Twitter)">{{> "icons/twitter"}}</a>
                <a class="gh-social-link" href="https://github.com/niklas_wortmann" target="_blank" rel="noopener" aria-label="GitHub">{{> "icons/github"}}</a>
                <a class="gh-social-link" href="https://www.linkedin.com/in/jan-niklas-wortmann/" target="_blank" rel="noopener" aria-label="LinkedIn">{{> "icons/linkedin"}}</a>
            </div>
            <div class="site-footer-newsletter">
                {{#if @site.members_enabled}}
                    <form class="site-footer-form" data-members-form="subscribe">
                        <label class="site-footer-label" for="footer-email">Newsletter</label>
                        <div class="site-footer-input-wrap">
                            <input id="footer-email" type="email" data-members-email placeholder="Email for Dev&apos;s Brew" required>
                            <button type="submit" aria-label="Subscribe"><span aria-hidden="true">&rsaquo;</span></button>
                        </div>
                        <p class="site-footer-feedback" data-members-success>Check your inbox and confirm your subscription.</p>
                        <p class="site-footer-feedback" data-members-error>Could not subscribe right now. Please try again.</p>
                    </form>
                {{else}}
                    <a class="site-footer-input-wrap site-footer-input-wrap--link" href="{{@site.url}}/newsletter/">
                        <span>Email for Dev&apos;s Brew</span>
                        <span aria-hidden="true">&rsaquo;</span>
                    </a>
                {{/if}}
            </div>
            <div class="site-footer-meta">
                <a href="{{@site.url}}">{{@site.title}}</a> &copy; {{date format="YYYY"}}
            </div>
        </div>
    </footer>

</div>
{{!-- /.viewport --}}

{{#is "post, page"}}
    {{> "lightbox"}}
{{/is}}

{{!-- Scripts - handle member signups, responsive videos, infinite scroll, floating headers, and galleries --}}
<script
    src="https://code.jquery.com/jquery-3.5.1.min.js"
    integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
    crossorigin="anonymous">
</script>
<script src="{{asset "built/casper.js"}}"></script>
<script>
$(document).ready(function () {
    // Mobile Menu Trigger
    $('.gh-burger').click(function () {
        $('body').toggleClass('gh-head-open');
    });
    // FitVids - Makes video embeds responsive
    $(".gh-content").fitVids();
});
</script>

{{!-- Ghost outputs required functional scripts with this tag - it should always be the last thing before the closing body tag --}}
{{ghost_foot}}

</body>
</html>
