{{!< default}}

<main id="site-main" class="site-main outer page-collection page-collection--newsletter">
<div class="inner posts">
    {{#post}}
        <section class="collection-hero newsletter-hero">
            <h1 class="collection-title">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="collection-description">{{custom_excerpt}}</p>
            {{/if}}
            {{#if @custom.newsletter_status}}
                <p class="collection-status">{{@custom.newsletter_status}}</p>
            {{/if}}
            <div class="collection-actions">
                {{#if @site.members_enabled}}
                    <a class="hero-button" href="#/portal/signup" data-portal="signup">Get the next experiment</a>
                {{else if @custom.newsletter_signup_url}}
                    <a class="hero-button" href="{{@custom.newsletter_signup_url}}">Get the next experiment</a>
                {{/if}}
                <a class="hero-button hero-button--ghost" href="#newsletter-archive">View archive</a>
            </div>
        </section>
    {{/post}}

    <section class="newsletter-archive" id="newsletter-archive">
        <div class="newsletter-archive-header">
            <h2>Past experiments</h2>
            <p>Previous workflow tests, verdicts, practical steps, and useful links.</p>
        </div>
        {{#get "posts" filter="tag:newsletter" include="tags,authors" limit="12" as |issues|}}
            {{#if issues.length}}
                <div class="issue-grid">
                    {{#foreach issues}}
                        <article class="issue-card">
                            <a class="issue-card-link" href="{{url}}">
                                <div class="issue-card-avatar">
                                    {{#if feature_image}}
                                        <img src="{{img_url feature_image size="s"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">
                                    {{else}}
                                        <img src="{{asset "images/weekly-devs-brew-logo-dark.svg"}}" alt="The Weekly Dev's Brew" loading="lazy">
                                    {{/if}}
                                </div>
                                <h3>{{title}}</h3>
                                {{#if excerpt}}
                                    <p>{{excerpt}}</p>
                                {{/if}}
                                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}} &middot; {{reading_time}}</time>
                            </a>
                        </article>
                    {{/foreach}}
                </div>
            {{else}}
                <p>No newsletter issues published yet.</p>
            {{/if}}
        {{/get}}
    </section>
</div>
</main>
